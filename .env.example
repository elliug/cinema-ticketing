# .env.example — copy to .env for local development. DEV-ONLY VALUES.

# --- PostgreSQL ---
POSTGRES_VERSION=16.5
POSTGRES_USER=cinema
POSTGRES_DB=cinema
# DEV-ONLY placeholder. Production values must come from a secrets vault.
POSTGRES_PW=change_me_in_local
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgres://cinema@127.0.0.1:5432/cinema?sslmode=disable

# --- PostgreSQL (canonical) ---
POSTGRES_PASSWORD=change_me_in_local

# --- API local administration (DEV-ONLY) ---
# Disabled by default. Enable only for local development: the API then mounts
# /api/v1/admin/ behind a loopback-peer + bearer-token guard. Never set these
# in production; API_ENV must be "development" or configuration loading fails.
API_ENV=development
API_LOCAL_ADMIN=false
API_LOCAL_ADMIN_TOKEN=change_me_in_local
API_DATABASE_URL=postgres://cinema:change_me_in_local@127.0.0.1:5432/cinema?sslmode=disable

# --- Ticket QR signing key ---
# Signs the code on the web page and the PDF, and verifies it at the door. At least
# 32 bytes of entropy-bearing text; never a real key in this file. When
# API_ENV=development an unset key falls back to a documented development key;
# outside development that fallback is refused and a real key is required, because a
# key that ships in a repository signs nothing. Rotating it invalidates every code
# already printed. Generate one with: openssl rand -base64 48
API_TICKET_QR_KEY=change_me_before_serving_tickets_32b

# --- Ticket email (optional, DEV-ONLY) ---
# The email is a second consumer of the outbox and never a step the sale waits for: leave
# all of this unset and the API starts no consumer and mails nothing, which is the state
# every gate runs in. `make mail-up` starts Mailpit locally.
#
# These two are read by compose.yaml (and by scripts/verify_email.sh) when the `mail`
# profile is brought up: SMTP on this port, inbox on the other.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
#
# These three are read by the API process, not by compose — a .env file is not loaded
# automatically, so export them or pass them inline as `## Run locally` shows. The
# consumer is built only when SMTP_ADDR and EMAIL_FROM are both set; exactly one is
# refused at startup instead of failing every tick.
API_SMTP_ADDR=127.0.0.1:1025
API_EMAIL_FROM=tickets@cinema.local
# Origin the mailed link points at, as <origin>/t/<token>. Must be absolute http(s).
API_PUBLIC_WEB_URL=http://localhost:3000

# --- Signed ticket link ---
# Signs the link a purchase email carries, with a key of its own: rotating it must not
# invalidate a printed QR, and the reverse. Same rules as the QR key above, and while
# API_ENV=development an unset key falls back to a documented development key, so this
# line stays commented until a deployment serves real links. At least 32 bytes.
# API_TICKET_LINK_KEY=change_me_before_mailing_links_32b
# How long a mailed link keeps working. 168h (seven days) is the documented default.
# API_TICKET_LINK_TTL=168h
